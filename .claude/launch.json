{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "edtech-design",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4599", "--directory", "design"],
      "port": 4599,
      "url": "http://localhost:4599"
    },
    {
      "name": "oceanembed-app",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "src/dashboard/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501,
      "url": "http://localhost:8501"
    },
    {
      "name": "oceanembed-web",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--host", "127.0.0.1", "--port", "4600"],
      "port": 4600,
      "url": "http://localhost:4600"
    }
  ]
}
